#cython: boundscheck=False
#cython: wraparound=False
#cython: cdivision=True
#cython: nonecheck=False
#cython: initializedcheck=False
#cython: overflowcheck=False
#cython: embedsignature=True
#cython: infer_types=False
r"""
Flat plates using the classical laminated plate theory (CLPT), total
Lagrangian: Green-Lagrange membrane strains and changes of curvature
measured with the deformed normal

Numerically integrated matrices and internal force vector of the model
``'plate_clpt_tl'``, generated by ``theory/shells/plate_clpt_tl/write_pyx.py``
from the derivation of ``theory/shells/plate_clpt_tl/plate_clpt_tl.py``.
The degrees of freedom of each term of the approximation are ``u, v, w``,
and the constitutive matrix ``Finput`` is the ``6 x 6`` matrix ``ABD`` of the
CLPT. The membrane strains are the Green-Lagrange strains of
``'plate_clpt_gl'``::

    exx = u,x + (u,x^2 + v,x^2 + w,x^2)/2
    eyy = v,y + (u,y^2 + v,y^2 + w,y^2)/2
    gxy = u,y + v,x + u,x u,y + v,x v,y + w,x w,y

and the changes of curvature are measured with the area vector of the
deformed mid-surface, ``a = X,x x X,y``, ``X = (x, y, 0) + (u, v, w)``::

    kxx = -a . (u,xx, v,xx, w,xx)
    kyy = -a . (u,yy, v,yy, w,yy)
    kxy = -2 a . (u,xy, v,xy, w,xy)

which are cubic in the displacements. The integrands are polynomials of
degree ``6p - 2`` along each direction for approximation functions of degree
``p``, integrated exactly by ``3p`` Gauss-Legendre points, the default of
:class:`.Shell` for this model. The mass and aerodynamic matrices,
``fkM_num``, ``fkAx_num`` and ``fkAy_num``, are those of
:mod:`panels.models.plate_clpt_donnell_num`.

"""
from scipy.sparse import coo_matrix
import numpy as np
from scipy.special import roots_legendre

from panels import INT, DOUBLE
#NOTE the linear kernels, independent of the strains, are those of the von
#     Karman plate
from .plate_clpt_donnell_num import fkM_num, fkAx_num, fkAy_num


cdef extern from 'bardell_functions.hpp':
    double f(int i, double xi, double xi1t, double xi1r, double xi2t, double xi2r) nogil
    double fp(int i, double xi, double xi1t, double xi1r, double xi2t, double xi2r) nogil
    double fpp(int i, double xi, double xi1t, double xi1r, double xi2t, double xi2r) nogil

cdef int DOF = 3


def fkC_num(double [::1] cs, object Finput, object shell,
        int size, int row0, int col0, int nx, int ny, int NLgeom=0):
    r"""Constitutive stiffness matrix, ``KC0 + KCNL + KGNL``

    With ``NLgeom=1`` the matrix at the state ``cs`` is
    ``int [Phi]^T ([B]^T [ABD] [B] + [H(sigma, d)] - [H0(sigma_L)]) [Phi]
    dA``, with ``[B] = d eps/d d``, ``[H(sigma, d)] = sum_r sigma_r d^2
    eps_r/d d^2`` at the stresses ``sigma = [ABD] eps``, and ``[H0(sigma_L)]``
    its value at ``d = 0`` with the stresses of the linear strains, the part
    assembled by :func:`.fkG_num`, such that ``KT = fkC_num + fkG_num`` is the
    exact Jacobian of :func:`.calc_fint`. With ``NLgeom=0`` it is the linear
    constitutive stiffness matrix ``KC0``.

    """
    cdef double x1, x2, y1, y2, xinf, xsup, yinf, ysup
    cdef double a, b, intx, inty
    cdef int m, n
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, p, q, r, s, row, col, ptx, pty
    cdef double xi, eta, weight
    cdef double xi1, xi2, eta1, eta2
    cdef double [:, ::1] ftab, gtab
    cdef double [::1] xis, etas, weights_xi, weights_eta

    cdef double u_x, u_y, v_x, v_y, w_x, w_y, u_xx, u_yy
    cdef double u_xy, v_xx, v_yy, v_xy, w_xx, w_yy, w_xy
    cdef double e[6]
    cdef double eL[6]
    cdef double sg[6]
    cdef double sgL[6]
    cdef double fAu, fAu_x, fAu_xx, fAv, fAv_x, fAv_xx, fAw
    cdef double fAw_x, fAw_xx, gAu, gAu_y, gAu_yy, gAv, gAv_y
    cdef double gAv_yy, gAw, gAw_y, gAw_yy, fBu, fBu_x, fBu_xx
    cdef double fBv, fBv_x, fBv_xx, fBw, fBw_x, fBw_xx, gBu
    cdef double gBu_y, gBu_yy, gBv, gBv_y, gBv_yy, gBw, gBw_y
    cdef double gBw_yy
    cdef double Bm[90]
    cdef double FB[90]
    cdef double K[225]
    cdef double TA[45]
    cdef double pA[15]
    cdef double pB[15]

    cdef long [::1] kCr, kCc
    cdef double [::1] kCv

    # F as 4-D matrix, must be [nx, ny, 6, 6], when there is one ABD[6, 6] for
    # each of the nx * ny integration points
    cdef double F[6 * 6]
    cdef double [:, :, :, ::1] Fnxny

    cdef int one_F_each_point = 0

    Finput = np.ascontiguousarray(Finput, dtype=DOUBLE)
    if Finput.shape == (nx, ny, 6, 6):
        Fnxny = Finput
        one_F_each_point = 1
    elif Finput.shape == (6, 6):
        # creating dummy 4-D array that is not used
        Fnxny = np.empty(shape=(0, 0, 0, 0), dtype=DOUBLE)
        # using a constant F for all the integration domain
        for i in range(6):
            for j in range(6):
                F[i*6 + j] = Finput[i, j]
    else:
        raise ValueError('Invalid shape for Finput!')

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    #NOTE physical limits of the integration domain, resolved and validated
    #      by Shell.integration_limits(); for the full domain the mapping
    #      below gives exactly xi1 = eta1 = -1 and xi2 = eta2 = +1
    x1, x2, y1, y2 = shell.integration_limits()
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)

    xinf = 0
    xsup = shell.a
    xi1 = (x1 - xinf)/(xsup - xinf)*2 - 1
    xi2 = (x2 - xinf)/(xsup - xinf)*2 - 1

    yinf = 0
    ysup = shell.b
    eta1 = (y1 - yinf)/(ysup - yinf)*2 - 1
    eta2 = (y2 - yinf)/(ysup - yinf)*2 - 1

    intx = x2 - x1
    inty = y2 - y1

    ftab = np.zeros((9, m), dtype=DOUBLE)
    gtab = np.zeros((9, n), dtype=DOUBLE)

    fdim = 9*m*m*n*n
    kCr = np.zeros((fdim,), dtype=INT)
    kCc = np.zeros((fdim,), dtype=INT)
    kCv = np.zeros((fdim,), dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                xi = xis[ptx]
                eta = etas[pty]
                xi = (xi - (-1))/2 * (xi2 - xi1) + xi1
                eta = (eta - (-1))/2 * (eta2 - eta1) + eta1

                # the integrands are per unit area of the natural domain
                weight = weights_xi[ptx]*weights_eta[pty]*intx*inty/4

                if one_F_each_point == 1:
                    for i in range(6):
                        for j in range(6):
                            F[i*6 + j] = Fnxny[ptx, pty, i, j]

                # approximation functions and their derivatives in x and y
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = (2/a)*fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = (2/a)*(2/a)*fpp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[3, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = (2/a)*fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[5, i] = (2/a)*(2/a)*fpp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[6, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[7, i] = (2/a)*fp(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[8, i] = (2/a)*(2/a)*fpp(i, xi, x1w, x1wr, x2w, x2wr)
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = (2/b)*fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = (2/b)*(2/b)*fpp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[3, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = (2/b)*fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[5, j] = (2/b)*(2/b)*fpp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[6, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[7, j] = (2/b)*fp(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[8, j] = (2/b)*(2/b)*fpp(j, eta, y1w, y1wr, y2w, y2wr)

                # generalized derivatives at the point, zero when NLgeom == 0
                u_x = 0.
                u_y = 0.
                v_x = 0.
                v_y = 0.
                w_x = 0.
                w_y = 0.
                u_xx = 0.
                u_yy = 0.
                u_xy = 0.
                v_xx = 0.
                v_yy = 0.
                v_xy = 0.
                w_xx = 0.
                w_yy = 0.
                w_xy = 0.
                if NLgeom == 1:
                    for j in range(n):
                        gAu = gtab[0, j]
                        gAu_y = gtab[1, j]
                        gAu_yy = gtab[2, j]
                        gAv = gtab[3, j]
                        gAv_y = gtab[4, j]
                        gAv_yy = gtab[5, j]
                        gAw = gtab[6, j]
                        gAw_y = gtab[7, j]
                        gAw_yy = gtab[8, j]
                        for i in range(m):
                            fAu = ftab[0, i]
                            fAu_x = ftab[1, i]
                            fAu_xx = ftab[2, i]
                            fAv = ftab[3, i]
                            fAv_x = ftab[4, i]
                            fAv_xx = ftab[5, i]
                            fAw = ftab[6, i]
                            fAw_x = ftab[7, i]
                            fAw_xx = ftab[8, i]
                            col = col0 + DOF*(j*m + i)
                            u_x += fAu_x*gAu*cs[col+0]
                            u_y += fAu*gAu_y*cs[col+0]
                            v_x += fAv_x*gAv*cs[col+1]
                            v_y += fAv*gAv_y*cs[col+1]
                            w_x += fAw_x*gAw*cs[col+2]
                            w_y += fAw*gAw_y*cs[col+2]
                            u_xx += fAu_xx*gAu*cs[col+0]
                            u_yy += fAu*gAu_yy*cs[col+0]
                            u_xy += fAu_x*gAu_y*cs[col+0]
                            v_xx += fAv_xx*gAv*cs[col+1]
                            v_yy += fAv*gAv_yy*cs[col+1]
                            v_xy += fAv_x*gAv_y*cs[col+1]
                            w_xx += fAw_xx*gAw*cs[col+2]
                            w_yy += fAw*gAw_yy*cs[col+2]
                            w_xy += fAw_x*gAw_y*cs[col+2]

                # [B] = d eps/d d at the point
                for p in range(90):
                    Bm[p] = 0.
                Bm[0] = u_x + 1
                Bm[2] = v_x
                Bm[4] = w_x
                Bm[16] = u_y
                Bm[18] = v_y + 1
                Bm[20] = w_y
                Bm[30] = u_y
                Bm[31] = u_x + 1
                Bm[32] = v_y + 1
                Bm[33] = v_x
                Bm[34] = w_y
                Bm[35] = w_x
                Bm[45] = v_xx*w_y - v_y*w_xx - w_xx
                Bm[46] = v_x*w_xx - v_xx*w_x
                Bm[47] = -u_xx*w_y + u_y*w_xx
                Bm[48] = -u_x*w_xx + u_xx*w_x - w_xx
                Bm[49] = u_xx*v_y + u_xx - u_y*v_xx
                Bm[50] = u_x*v_xx - u_xx*v_x + v_xx
                Bm[51] = -v_x*w_y + v_y*w_x + w_x
                Bm[54] = u_x*w_y - u_y*w_x + w_y
                Bm[57] = -u_x*v_y - u_x + u_y*v_x - v_y - 1
                Bm[60] = -v_y*w_yy + v_yy*w_y - w_yy
                Bm[61] = v_x*w_yy - v_yy*w_x
                Bm[62] = u_y*w_yy - u_yy*w_y
                Bm[63] = -u_x*w_yy + u_yy*w_x - w_yy
                Bm[64] = -u_y*v_yy + u_yy*v_y + u_yy
                Bm[65] = u_x*v_yy - u_yy*v_x + v_yy
                Bm[67] = -v_x*w_y + v_y*w_x + w_x
                Bm[70] = u_x*w_y - u_y*w_x + w_y
                Bm[73] = -u_x*v_y - u_x + u_y*v_x - v_y - 1
                Bm[75] = 2*v_xy*w_y - 2*v_y*w_xy - 2*w_xy
                Bm[76] = 2*v_x*w_xy - 2*v_xy*w_x
                Bm[77] = -2*u_xy*w_y + 2*u_y*w_xy
                Bm[78] = -2*u_x*w_xy + 2*u_xy*w_x - 2*w_xy
                Bm[79] = 2*u_xy*v_y + 2*u_xy - 2*u_y*v_xy
                Bm[80] = 2*u_x*v_xy - 2*u_xy*v_x + 2*v_xy
                Bm[83] = -2*v_x*w_y + 2*v_y*w_x + 2*w_x
                Bm[86] = 2*u_x*w_y - 2*u_y*w_x + 2*w_y
                Bm[89] = -2*u_x*v_y - 2*u_x + 2*u_y*v_x - 2*v_y - 2

                # K = [B]^T [ABD] [B]
                for r in range(6):
                    for q in range(15):
                        FB[r*15 + q] = 0.
                        for s in range(6):
                            FB[r*15 + q] += F[r*6 + s]*Bm[s*15 + q]
                for p in range(15):
                    for q in range(15):
                        K[p*15 + q] = 0.
                        for r in range(6):
                            K[p*15 + q] += Bm[r*15 + p]*FB[r*15 + q]

                # stresses of the strains and of the linear strains
                e[0] = 0.5*(u_x*u_x) + u_x + 0.5*(v_x*v_x) + 0.5*(w_x*w_x)
                e[1] = 0.5*(u_y*u_y) + 0.5*(v_y*v_y) + v_y + 0.5*(w_y*w_y)
                e[2] = u_x*u_y + u_y + v_x*v_y + v_x + w_x*w_y
                e[3] = u_x*v_xx*w_y - u_x*v_y*w_xx - u_x*w_xx - u_xx*v_x*w_y + u_xx*v_y*w_x + u_xx*w_x + u_y*v_x*w_xx - u_y*v_xx*w_x + v_xx*w_y - v_y*w_xx - w_xx
                e[4] = -u_x*v_y*w_yy + u_x*v_yy*w_y - u_x*w_yy + u_y*v_x*w_yy - u_y*v_yy*w_x - u_yy*v_x*w_y + u_yy*v_y*w_x + u_yy*w_x - v_y*w_yy + v_yy*w_y - w_yy
                e[5] = 2*u_x*v_xy*w_y - 2*u_x*v_y*w_xy - 2*u_x*w_xy - 2*u_xy*v_x*w_y + 2*u_xy*v_y*w_x + 2*u_xy*w_x + 2*u_y*v_x*w_xy - 2*u_y*v_xy*w_x + 2*v_xy*w_y - 2*v_y*w_xy - 2*w_xy
                eL[0] = u_x
                eL[1] = v_y
                eL[2] = u_y + v_x
                eL[3] = -w_xx
                eL[4] = -w_yy
                eL[5] = -2*w_xy
                for r in range(6):
                    sg[r] = 0.
                    for s in range(6):
                        sg[r] += F[r*6 + s]*e[s]
                for r in range(6):
                    sgL[r] = 0.
                    for s in range(6):
                        sgL[r] += F[r*6 + s]*eL[s]
                # K += [H(sigma, d)] - [H0(sigma_L)], the second term being
                # assembled by fkG_num, which is homogeneous of degree one
                # in cs as linear buckling requires
                K[0] += -sgL[0] + sg[0]
                K[1] += -sgL[2] + sg[2]
                K[3] += -sg[3]*w_xx - sg[4]*w_yy - 2*sg[5]*w_xy
                K[5] += sg[3]*v_xx + sg[4]*v_yy + 2*sg[5]*v_xy
                K[9] += sg[3]*w_y
                K[10] += sg[4]*w_y
                K[11] += 2*sg[5]*w_y
                K[12] += sgL[3] - sg[3]*v_y - sg[3]
                K[13] += sgL[4] - sg[4]*v_y - sg[4]
                K[14] += 2*sgL[5] - 2*sg[5]*v_y - 2*sg[5]
                K[15] += -sgL[2] + sg[2]
                K[16] += -sgL[1] + sg[1]
                K[17] += sg[3]*w_xx + sg[4]*w_yy + 2*sg[5]*w_xy
                K[19] += -sg[3]*v_xx - sg[4]*v_yy - 2*sg[5]*v_xy
                K[24] += -sg[3]*w_x
                K[25] += -sg[4]*w_x
                K[26] += -2*sg[5]*w_x
                K[27] += sg[3]*v_x
                K[28] += sg[4]*v_x
                K[29] += 2*sg[5]*v_x
                K[31] += sg[3]*w_xx + sg[4]*w_yy + 2*sg[5]*w_xy
                K[32] += -sgL[0] + sg[0]
                K[33] += -sgL[2] + sg[2]
                K[35] += -sg[3]*u_xx - sg[4]*u_yy - 2*sg[5]*u_xy
                K[36] += -sg[3]*w_y
                K[37] += -sg[4]*w_y
                K[38] += -2*sg[5]*w_y
                K[42] += sg[3]*u_y
                K[43] += sg[4]*u_y
                K[44] += 2*sg[5]*u_y
                K[45] += -sg[3]*w_xx - sg[4]*w_yy - 2*sg[5]*w_xy
                K[47] += -sgL[2] + sg[2]
                K[48] += -sgL[1] + sg[1]
                K[49] += sg[3]*u_xx + sg[4]*u_yy + 2*sg[5]*u_xy
                K[51] += sg[3]*w_x
                K[52] += sg[4]*w_x
                K[53] += 2*sg[5]*w_x
                K[57] += sgL[3] - sg[3]*u_x - sg[3]
                K[58] += sgL[4] - sg[4]*u_x - sg[4]
                K[59] += 2*sgL[5] - 2*sg[5]*u_x - 2*sg[5]
                K[61] += -sg[3]*v_xx - sg[4]*v_yy - 2*sg[5]*v_xy
                K[63] += sg[3]*u_xx + sg[4]*u_yy + 2*sg[5]*u_xy
                K[64] += -sgL[0] + sg[0]
                K[65] += -sgL[2] + sg[2]
                K[66] += -sgL[3] + sg[3]*v_y + sg[3]
                K[67] += -sgL[4] + sg[4]*v_y + sg[4]
                K[68] += -2*sgL[5] + 2*sg[5]*v_y + 2*sg[5]
                K[69] += -sg[3]*u_y
                K[70] += -sg[4]*u_y
                K[71] += -2*sg[5]*u_y
                K[75] += sg[3]*v_xx + sg[4]*v_yy + 2*sg[5]*v_xy
                K[77] += -sg[3]*u_xx - sg[4]*u_yy - 2*sg[5]*u_xy
                K[79] += -sgL[2] + sg[2]
                K[80] += -sgL[1] + sg[1]
                K[81] += -sg[3]*v_x
                K[82] += -sg[4]*v_x
                K[83] += -2*sg[5]*v_x
                K[84] += -sgL[3] + sg[3]*u_x + sg[3]
                K[85] += -sgL[4] + sg[4]*u_x + sg[4]
                K[86] += -2*sgL[5] + 2*sg[5]*u_x + 2*sg[5]
                K[92] += -sg[3]*w_y
                K[93] += sg[3]*w_x
                K[94] += -sgL[3] + sg[3]*v_y + sg[3]
                K[95] += -sg[3]*v_x
                K[107] += -sg[4]*w_y
                K[108] += sg[4]*w_x
                K[109] += -sgL[4] + sg[4]*v_y + sg[4]
                K[110] += -sg[4]*v_x
                K[122] += -2*sg[5]*w_y
                K[123] += 2*sg[5]*w_x
                K[124] += -2*sgL[5] + 2*sg[5]*v_y + 2*sg[5]
                K[125] += -2*sg[5]*v_x
                K[135] += sg[3]*w_y
                K[136] += -sg[3]*w_x
                K[139] += -sg[3]*u_y
                K[140] += -sgL[3] + sg[3]*u_x + sg[3]
                K[150] += sg[4]*w_y
                K[151] += -sg[4]*w_x
                K[154] += -sg[4]*u_y
                K[155] += -sgL[4] + sg[4]*u_x + sg[4]
                K[165] += 2*sg[5]*w_y
                K[166] += -2*sg[5]*w_x
                K[169] += -2*sg[5]*u_y
                K[170] += -2*sgL[5] + 2*sg[5]*u_x + 2*sg[5]
                K[180] += sgL[3] - sg[3]*v_y - sg[3]
                K[181] += sg[3]*v_x
                K[182] += sg[3]*u_y
                K[183] += sgL[3] - sg[3]*u_x - sg[3]
                K[195] += sgL[4] - sg[4]*v_y - sg[4]
                K[196] += sg[4]*v_x
                K[197] += sg[4]*u_y
                K[198] += sgL[4] - sg[4]*u_x - sg[4]
                K[210] += 2*sgL[5] - 2*sg[5]*v_y - 2*sg[5]
                K[211] += 2*sg[5]*v_x
                K[212] += 2*sg[5]*u_y
                K[213] += 2*sgL[5] - 2*sg[5]*u_x - 2*sg[5]

                c = -1
                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        row = row0 + DOF*(j*m + i)
                        pA[0] = fAu_x*gAu
                        pA[1] = fAu*gAu_y
                        pA[2] = fAv_x*gAv
                        pA[3] = fAv*gAv_y
                        pA[4] = fAw_x*gAw
                        pA[5] = fAw*gAw_y
                        pA[6] = fAu_xx*gAu
                        pA[7] = fAu*gAu_yy
                        pA[8] = fAu_x*gAu_y
                        pA[9] = fAv_xx*gAv
                        pA[10] = fAv*gAv_yy
                        pA[11] = fAv_x*gAv_y
                        pA[12] = fAw_xx*gAw
                        pA[13] = fAw*gAw_yy
                        pA[14] = fAw_x*gAw_y
                        # TA[d, q] = sum_p Phi_A[p, d] K[p, q]
                        TA[0] = pA[0]*K[0] + pA[1]*K[15] + pA[6]*K[90] + pA[7]*K[105] + pA[8]*K[120]
                        TA[1] = pA[0]*K[1] + pA[1]*K[16] + pA[6]*K[91] + pA[7]*K[106] + pA[8]*K[121]
                        TA[2] = pA[0]*K[2] + pA[1]*K[17] + pA[6]*K[92] + pA[7]*K[107] + pA[8]*K[122]
                        TA[3] = pA[0]*K[3] + pA[1]*K[18] + pA[6]*K[93] + pA[7]*K[108] + pA[8]*K[123]
                        TA[4] = pA[0]*K[4] + pA[1]*K[19] + pA[6]*K[94] + pA[7]*K[109] + pA[8]*K[124]
                        TA[5] = pA[0]*K[5] + pA[1]*K[20] + pA[6]*K[95] + pA[7]*K[110] + pA[8]*K[125]
                        TA[6] = pA[0]*K[6] + pA[1]*K[21] + pA[6]*K[96] + pA[7]*K[111] + pA[8]*K[126]
                        TA[7] = pA[0]*K[7] + pA[1]*K[22] + pA[6]*K[97] + pA[7]*K[112] + pA[8]*K[127]
                        TA[8] = pA[0]*K[8] + pA[1]*K[23] + pA[6]*K[98] + pA[7]*K[113] + pA[8]*K[128]
                        TA[9] = pA[0]*K[9] + pA[1]*K[24] + pA[6]*K[99] + pA[7]*K[114] + pA[8]*K[129]
                        TA[10] = pA[0]*K[10] + pA[1]*K[25] + pA[6]*K[100] + pA[7]*K[115] + pA[8]*K[130]
                        TA[11] = pA[0]*K[11] + pA[1]*K[26] + pA[6]*K[101] + pA[7]*K[116] + pA[8]*K[131]
                        TA[12] = pA[0]*K[12] + pA[1]*K[27] + pA[6]*K[102] + pA[7]*K[117] + pA[8]*K[132]
                        TA[13] = pA[0]*K[13] + pA[1]*K[28] + pA[6]*K[103] + pA[7]*K[118] + pA[8]*K[133]
                        TA[14] = pA[0]*K[14] + pA[1]*K[29] + pA[6]*K[104] + pA[7]*K[119] + pA[8]*K[134]
                        TA[15] = pA[2]*K[30] + pA[3]*K[45] + pA[9]*K[135] + pA[10]*K[150] + pA[11]*K[165]
                        TA[16] = pA[2]*K[31] + pA[3]*K[46] + pA[9]*K[136] + pA[10]*K[151] + pA[11]*K[166]
                        TA[17] = pA[2]*K[32] + pA[3]*K[47] + pA[9]*K[137] + pA[10]*K[152] + pA[11]*K[167]
                        TA[18] = pA[2]*K[33] + pA[3]*K[48] + pA[9]*K[138] + pA[10]*K[153] + pA[11]*K[168]
                        TA[19] = pA[2]*K[34] + pA[3]*K[49] + pA[9]*K[139] + pA[10]*K[154] + pA[11]*K[169]
                        TA[20] = pA[2]*K[35] + pA[3]*K[50] + pA[9]*K[140] + pA[10]*K[155] + pA[11]*K[170]
                        TA[21] = pA[2]*K[36] + pA[3]*K[51] + pA[9]*K[141] + pA[10]*K[156] + pA[11]*K[171]
                        TA[22] = pA[2]*K[37] + pA[3]*K[52] + pA[9]*K[142] + pA[10]*K[157] + pA[11]*K[172]
                        TA[23] = pA[2]*K[38] + pA[3]*K[53] + pA[9]*K[143] + pA[10]*K[158] + pA[11]*K[173]
                        TA[24] = pA[2]*K[39] + pA[3]*K[54] + pA[9]*K[144] + pA[10]*K[159] + pA[11]*K[174]
                        TA[25] = pA[2]*K[40] + pA[3]*K[55] + pA[9]*K[145] + pA[10]*K[160] + pA[11]*K[175]
                        TA[26] = pA[2]*K[41] + pA[3]*K[56] + pA[9]*K[146] + pA[10]*K[161] + pA[11]*K[176]
                        TA[27] = pA[2]*K[42] + pA[3]*K[57] + pA[9]*K[147] + pA[10]*K[162] + pA[11]*K[177]
                        TA[28] = pA[2]*K[43] + pA[3]*K[58] + pA[9]*K[148] + pA[10]*K[163] + pA[11]*K[178]
                        TA[29] = pA[2]*K[44] + pA[3]*K[59] + pA[9]*K[149] + pA[10]*K[164] + pA[11]*K[179]
                        TA[30] = pA[4]*K[60] + pA[5]*K[75] + pA[12]*K[180] + pA[13]*K[195] + pA[14]*K[210]
                        TA[31] = pA[4]*K[61] + pA[5]*K[76] + pA[12]*K[181] + pA[13]*K[196] + pA[14]*K[211]
                        TA[32] = pA[4]*K[62] + pA[5]*K[77] + pA[12]*K[182] + pA[13]*K[197] + pA[14]*K[212]
                        TA[33] = pA[4]*K[63] + pA[5]*K[78] + pA[12]*K[183] + pA[13]*K[198] + pA[14]*K[213]
                        TA[34] = pA[4]*K[64] + pA[5]*K[79] + pA[12]*K[184] + pA[13]*K[199] + pA[14]*K[214]
                        TA[35] = pA[4]*K[65] + pA[5]*K[80] + pA[12]*K[185] + pA[13]*K[200] + pA[14]*K[215]
                        TA[36] = pA[4]*K[66] + pA[5]*K[81] + pA[12]*K[186] + pA[13]*K[201] + pA[14]*K[216]
                        TA[37] = pA[4]*K[67] + pA[5]*K[82] + pA[12]*K[187] + pA[13]*K[202] + pA[14]*K[217]
                        TA[38] = pA[4]*K[68] + pA[5]*K[83] + pA[12]*K[188] + pA[13]*K[203] + pA[14]*K[218]
                        TA[39] = pA[4]*K[69] + pA[5]*K[84] + pA[12]*K[189] + pA[13]*K[204] + pA[14]*K[219]
                        TA[40] = pA[4]*K[70] + pA[5]*K[85] + pA[12]*K[190] + pA[13]*K[205] + pA[14]*K[220]
                        TA[41] = pA[4]*K[71] + pA[5]*K[86] + pA[12]*K[191] + pA[13]*K[206] + pA[14]*K[221]
                        TA[42] = pA[4]*K[72] + pA[5]*K[87] + pA[12]*K[192] + pA[13]*K[207] + pA[14]*K[222]
                        TA[43] = pA[4]*K[73] + pA[5]*K[88] + pA[12]*K[193] + pA[13]*K[208] + pA[14]*K[223]
                        TA[44] = pA[4]*K[74] + pA[5]*K[89] + pA[12]*K[194] + pA[13]*K[209] + pA[14]*K[224]
                        for l in range(n):
                            gBu = gtab[0, l]
                            gBu_y = gtab[1, l]
                            gBu_yy = gtab[2, l]
                            gBv = gtab[3, l]
                            gBv_y = gtab[4, l]
                            gBv_yy = gtab[5, l]
                            gBw = gtab[6, l]
                            gBw_y = gtab[7, l]
                            gBw_yy = gtab[8, l]
                            for k in range(m):
                                col = col0 + DOF*(l*m + k)
                                #NOTE symmetry assumption True if no follower forces are used
                                if row > col:
                                    continue
                                fBu = ftab[0, k]
                                fBu_x = ftab[1, k]
                                fBu_xx = ftab[2, k]
                                fBv = ftab[3, k]
                                fBv_x = ftab[4, k]
                                fBv_xx = ftab[5, k]
                                fBw = ftab[6, k]
                                fBw_x = ftab[7, k]
                                fBw_xx = ftab[8, k]
                                pB[0] = fBu_x*gBu
                                pB[1] = fBu*gBu_y
                                pB[2] = fBv_x*gBv
                                pB[3] = fBv*gBv_y
                                pB[4] = fBw_x*gBw
                                pB[5] = fBw*gBw_y
                                pB[6] = fBu_xx*gBu
                                pB[7] = fBu*gBu_yy
                                pB[8] = fBu_x*gBu_y
                                pB[9] = fBv_xx*gBv
                                pB[10] = fBv*gBv_yy
                                pB[11] = fBv_x*gBv_y
                                pB[12] = fBw_xx*gBw
                                pB[13] = fBw*gBw_yy
                                pB[14] = fBw_x*gBw_y
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+0
                                    kCc[c] = col+0
                                kCv[c] += weight*(TA[0]*pB[0] + TA[1]*pB[1] + TA[6]*pB[6] + TA[7]*pB[7] + TA[8]*pB[8])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+0
                                    kCc[c] = col+1
                                kCv[c] += weight*(TA[2]*pB[2] + TA[3]*pB[3] + TA[9]*pB[9] + TA[10]*pB[10] + TA[11]*pB[11])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+0
                                    kCc[c] = col+2
                                kCv[c] += weight*(TA[4]*pB[4] + TA[5]*pB[5] + TA[12]*pB[12] + TA[13]*pB[13] + TA[14]*pB[14])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+1
                                    kCc[c] = col+0
                                kCv[c] += weight*(TA[15]*pB[0] + TA[16]*pB[1] + TA[21]*pB[6] + TA[22]*pB[7] + TA[23]*pB[8])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+1
                                    kCc[c] = col+1
                                kCv[c] += weight*(TA[17]*pB[2] + TA[18]*pB[3] + TA[24]*pB[9] + TA[25]*pB[10] + TA[26]*pB[11])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+1
                                    kCc[c] = col+2
                                kCv[c] += weight*(TA[19]*pB[4] + TA[20]*pB[5] + TA[27]*pB[12] + TA[28]*pB[13] + TA[29]*pB[14])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+2
                                    kCc[c] = col+0
                                kCv[c] += weight*(TA[30]*pB[0] + TA[31]*pB[1] + TA[36]*pB[6] + TA[37]*pB[7] + TA[38]*pB[8])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+2
                                    kCc[c] = col+1
                                kCv[c] += weight*(TA[32]*pB[2] + TA[33]*pB[3] + TA[39]*pB[9] + TA[40]*pB[10] + TA[41]*pB[11])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+2
                                    kCc[c] = col+2
                                kCv[c] += weight*(TA[34]*pB[4] + TA[35]*pB[5] + TA[42]*pB[12] + TA[43]*pB[13] + TA[44]*pB[14])

    kC = coo_matrix((kCv, (kCr, kCc)), shape=(size, size))

    return kC


def fkG_num(double [::1] cs, object Finput, object shell,
            int size, int row0, int col0, int nx, int ny,
            double Nxx0=0, double Nyy0=0, double Nxy0=0):
    r"""Geometric stiffness matrix of the linear stress state

    ``int [Phi]^T [H0(sigma)] [Phi] dA``, with ``sigma = (Nxx0, Nyy0, Nxy0,
    0, 0, 0) + sigma_L``, ``sigma_L`` the stresses of the *linear* strains at
    ``cs``, and ``[H0]`` the second derivative of the strains at ``d = 0``:
    one block ``[[Nxx, Nxy], [Nxy, Nyy]]`` for each of the gradients of
    ``u``, ``v`` and ``w``, as in ``plate_clpt_gl``, and the coupling of the
    gradients of ``u`` and ``v`` with the second derivatives of ``w``, and of
    the gradients of ``w`` with the second derivatives of ``u`` and ``v``,
    by the moments ``Mxx, Myy, Mxy``. The result is homogeneous of degree one
    in ``cs``, which is what the linear buckling eigenvalue problem requires.
    The rest of the tangent stiffness enters through :func:`.fkC_num`, such
    that

        KT = KC0 + KCNL + KGNL   (fkC_num)
             + KG(Nbar + sigma_L)  (fkG_num)

    is the exact Jacobian of :func:`.calc_fint`.

    """
    cdef double x1, x2, y1, y2, xinf, xsup, yinf, ysup
    cdef double a, b, intx, inty
    cdef int m, n
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, p, q, r, s, row, col, ptx, pty
    cdef double xi, eta, weight
    cdef double xi1, xi2, eta1, eta2
    cdef double [:, ::1] ftab, gtab
    cdef double [::1] xis, etas, weights_xi, weights_eta

    cdef double u_x, u_y, v_x, v_y, w_xx, w_yy, w_xy
    cdef double e[6]
    cdef double sg[6]
    cdef double fAu, fAu_x, fAu_xx, fAv, fAv_x, fAv_xx, fAw
    cdef double fAw_x, fAw_xx, gAu, gAu_y, gAu_yy, gAv, gAv_y
    cdef double gAv_yy, gAw, gAw_y, gAw_yy, fBu, fBu_x, fBu_xx
    cdef double fBv, fBv_x, fBv_xx, fBw, fBw_x, fBw_xx, gBu
    cdef double gBu_y, gBu_yy, gBv, gBv_y, gBv_yy, gBw, gBw_y
    cdef double gBw_yy
    cdef double K[225]
    cdef double TA[45]
    cdef double pA[15]
    cdef double pB[15]

    cdef long [::1] kGr, kGc
    cdef double [::1] kGv

    # F as 4-D matrix, must be [nx, ny, 6, 6], when there is one ABD[6, 6] for
    # each of the nx * ny integration points
    cdef double F[6 * 6]
    cdef double [:, :, :, ::1] Fnxny

    cdef int one_F_each_point = 0

    Finput = np.ascontiguousarray(Finput, dtype=DOUBLE)
    if Finput.shape == (nx, ny, 6, 6):
        Fnxny = Finput
        one_F_each_point = 1
    elif Finput.shape == (6, 6):
        # creating dummy 4-D array that is not used
        Fnxny = np.empty(shape=(0, 0, 0, 0), dtype=DOUBLE)
        # using a constant F for all the integration domain
        for i in range(6):
            for j in range(6):
                F[i*6 + j] = Finput[i, j]
    else:
        raise ValueError('Invalid shape for Finput!')

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    #NOTE physical limits of the integration domain, resolved and validated
    #      by Shell.integration_limits(); for the full domain the mapping
    #      below gives exactly xi1 = eta1 = -1 and xi2 = eta2 = +1
    x1, x2, y1, y2 = shell.integration_limits()
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)

    xinf = 0
    xsup = shell.a
    xi1 = (x1 - xinf)/(xsup - xinf)*2 - 1
    xi2 = (x2 - xinf)/(xsup - xinf)*2 - 1

    yinf = 0
    ysup = shell.b
    eta1 = (y1 - yinf)/(ysup - yinf)*2 - 1
    eta2 = (y2 - yinf)/(ysup - yinf)*2 - 1

    intx = x2 - x1
    inty = y2 - y1

    ftab = np.zeros((9, m), dtype=DOUBLE)
    gtab = np.zeros((9, n), dtype=DOUBLE)

    fdim = 7*m*m*n*n
    kGr = np.zeros((fdim,), dtype=INT)
    kGc = np.zeros((fdim,), dtype=INT)
    kGv = np.zeros((fdim,), dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                xi = xis[ptx]
                eta = etas[pty]
                xi = (xi - (-1))/2 * (xi2 - xi1) + xi1
                eta = (eta - (-1))/2 * (eta2 - eta1) + eta1

                # the integrands are per unit area of the natural domain
                weight = weights_xi[ptx]*weights_eta[pty]*intx*inty/4

                if one_F_each_point == 1:
                    for i in range(6):
                        for j in range(6):
                            F[i*6 + j] = Fnxny[ptx, pty, i, j]

                # approximation functions and their derivatives in x and y
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = (2/a)*fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = (2/a)*(2/a)*fpp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[3, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = (2/a)*fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[5, i] = (2/a)*(2/a)*fpp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[6, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[7, i] = (2/a)*fp(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[8, i] = (2/a)*(2/a)*fpp(i, xi, x1w, x1wr, x2w, x2wr)
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = (2/b)*fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = (2/b)*(2/b)*fpp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[3, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = (2/b)*fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[5, j] = (2/b)*(2/b)*fpp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[6, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[7, j] = (2/b)*fp(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[8, j] = (2/b)*(2/b)*fpp(j, eta, y1w, y1wr, y2w, y2wr)

                # derivatives of the linear strains at the point
                u_x = 0.
                u_y = 0.
                v_x = 0.
                v_y = 0.
                w_xx = 0.
                w_yy = 0.
                w_xy = 0.
                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        col = col0 + DOF*(j*m + i)
                        u_x += fAu_x*gAu*cs[col+0]
                        u_y += fAu*gAu_y*cs[col+0]
                        v_x += fAv_x*gAv*cs[col+1]
                        v_y += fAv*gAv_y*cs[col+1]
                        w_xx += fAw_xx*gAw*cs[col+2]
                        w_yy += fAw*gAw_yy*cs[col+2]
                        w_xy += fAw_x*gAw_y*cs[col+2]

                # linear strains and stresses
                e[0] = u_x
                e[1] = v_y
                e[2] = u_y + v_x
                e[3] = -w_xx
                e[4] = -w_yy
                e[5] = -2*w_xy
                for r in range(6):
                    sg[r] = 0.
                    for s in range(6):
                        sg[r] += F[r*6 + s]*e[s]
                sg[0] += Nxx0
                sg[1] += Nyy0
                sg[2] += Nxy0

                # K = [H0(sigma)]
                K[0] = sg[0]
                K[1] = sg[2]
                K[12] = -sg[3]
                K[13] = -sg[4]
                K[14] = -2*sg[5]
                K[15] = sg[2]
                K[16] = sg[1]
                K[32] = sg[0]
                K[33] = sg[2]
                K[47] = sg[2]
                K[48] = sg[1]
                K[57] = -sg[3]
                K[58] = -sg[4]
                K[59] = -2*sg[5]
                K[64] = sg[0]
                K[65] = sg[2]
                K[66] = sg[3]
                K[67] = sg[4]
                K[68] = 2*sg[5]
                K[79] = sg[2]
                K[80] = sg[1]
                K[84] = sg[3]
                K[85] = sg[4]
                K[86] = 2*sg[5]
                K[94] = sg[3]
                K[109] = sg[4]
                K[124] = 2*sg[5]
                K[140] = sg[3]
                K[155] = sg[4]
                K[170] = 2*sg[5]
                K[180] = -sg[3]
                K[183] = -sg[3]
                K[195] = -sg[4]
                K[198] = -sg[4]
                K[210] = -2*sg[5]
                K[213] = -2*sg[5]

                c = -1
                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        row = row0 + DOF*(j*m + i)
                        pA[0] = fAu_x*gAu
                        pA[1] = fAu*gAu_y
                        pA[2] = fAv_x*gAv
                        pA[3] = fAv*gAv_y
                        pA[4] = fAw_x*gAw
                        pA[5] = fAw*gAw_y
                        pA[6] = fAu_xx*gAu
                        pA[7] = fAu*gAu_yy
                        pA[8] = fAu_x*gAu_y
                        pA[9] = fAv_xx*gAv
                        pA[10] = fAv*gAv_yy
                        pA[11] = fAv_x*gAv_y
                        pA[12] = fAw_xx*gAw
                        pA[13] = fAw*gAw_yy
                        pA[14] = fAw_x*gAw_y
                        # TA[d, q] = sum_p Phi_A[p, d] K[p, q]
                        TA[0] = pA[0]*K[0] + pA[1]*K[15]
                        TA[1] = pA[0]*K[1] + pA[1]*K[16]
                        TA[4] = pA[6]*K[94] + pA[7]*K[109] + pA[8]*K[124]
                        TA[12] = pA[0]*K[12]
                        TA[13] = pA[0]*K[13]
                        TA[14] = pA[0]*K[14]
                        TA[17] = pA[2]*K[32] + pA[3]*K[47]
                        TA[18] = pA[2]*K[33] + pA[3]*K[48]
                        TA[20] = pA[9]*K[140] + pA[10]*K[155] + pA[11]*K[170]
                        TA[27] = pA[3]*K[57]
                        TA[28] = pA[3]*K[58]
                        TA[29] = pA[3]*K[59]
                        TA[30] = pA[12]*K[180] + pA[13]*K[195] + pA[14]*K[210]
                        TA[33] = pA[12]*K[183] + pA[13]*K[198] + pA[14]*K[213]
                        TA[34] = pA[4]*K[64] + pA[5]*K[79]
                        TA[35] = pA[4]*K[65] + pA[5]*K[80]
                        TA[36] = pA[4]*K[66]
                        TA[37] = pA[4]*K[67]
                        TA[38] = pA[4]*K[68]
                        TA[39] = pA[5]*K[84]
                        TA[40] = pA[5]*K[85]
                        TA[41] = pA[5]*K[86]
                        for l in range(n):
                            gBu = gtab[0, l]
                            gBu_y = gtab[1, l]
                            gBu_yy = gtab[2, l]
                            gBv = gtab[3, l]
                            gBv_y = gtab[4, l]
                            gBv_yy = gtab[5, l]
                            gBw = gtab[6, l]
                            gBw_y = gtab[7, l]
                            gBw_yy = gtab[8, l]
                            for k in range(m):
                                col = col0 + DOF*(l*m + k)
                                #NOTE symmetry assumption True if no follower forces are used
                                if row > col:
                                    continue
                                fBu = ftab[0, k]
                                fBu_x = ftab[1, k]
                                fBu_xx = ftab[2, k]
                                fBv = ftab[3, k]
                                fBv_x = ftab[4, k]
                                fBv_xx = ftab[5, k]
                                fBw = ftab[6, k]
                                fBw_x = ftab[7, k]
                                fBw_xx = ftab[8, k]
                                pB[0] = fBu_x*gBu
                                pB[1] = fBu*gBu_y
                                pB[2] = fBv_x*gBv
                                pB[3] = fBv*gBv_y
                                pB[4] = fBw_x*gBw
                                pB[5] = fBw*gBw_y
                                pB[6] = fBu_xx*gBu
                                pB[7] = fBu*gBu_yy
                                pB[8] = fBu_x*gBu_y
                                pB[9] = fBv_xx*gBv
                                pB[10] = fBv*gBv_yy
                                pB[11] = fBv_x*gBv_y
                                pB[12] = fBw_xx*gBw
                                pB[13] = fBw*gBw_yy
                                pB[14] = fBw_x*gBw_y
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+0
                                    kGc[c] = col+0
                                kGv[c] += weight*(TA[0]*pB[0] + TA[1]*pB[1])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+0
                                    kGc[c] = col+2
                                kGv[c] += weight*(TA[4]*pB[4] + TA[12]*pB[12] + TA[13]*pB[13] + TA[14]*pB[14])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+1
                                    kGc[c] = col+1
                                kGv[c] += weight*(TA[17]*pB[2] + TA[18]*pB[3])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+1
                                    kGc[c] = col+2
                                kGv[c] += weight*(TA[20]*pB[5] + TA[27]*pB[12] + TA[28]*pB[13] + TA[29]*pB[14])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+2
                                    kGc[c] = col+0
                                kGv[c] += weight*(TA[30]*pB[0] + TA[36]*pB[6] + TA[37]*pB[7] + TA[38]*pB[8])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+2
                                    kGc[c] = col+1
                                kGv[c] += weight*(TA[33]*pB[3] + TA[39]*pB[9] + TA[40]*pB[10] + TA[41]*pB[11])
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kGr[c] = row+2
                                    kGc[c] = col+2
                                kGv[c] += weight*(TA[34]*pB[4] + TA[35]*pB[5])

    kG = coo_matrix((kGv, (kGr, kGc)), shape=(size, size))

    return kG


def calc_fint(double [::1] cs, object Finput, object shell,
        int size, int col0, int nx, int ny):
    r"""Internal force vector ``int [Phi]^T [B]^T sigma dA``

    With the Green-Lagrange membrane strains and the changes of curvature at
    ``cs``, and ``sigma = [ABD] eps``.

    """
    cdef double x1, x2, y1, y2, xinf, xsup, yinf, ysup
    cdef double a, b, intx, inty
    cdef int m, n
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, p, q, r, s, row, col, ptx, pty
    cdef double xi, eta, weight
    cdef double xi1, xi2, eta1, eta2
    cdef double [:, ::1] ftab, gtab
    cdef double [::1] xis, etas, weights_xi, weights_eta

    cdef double u_x, u_y, v_x, v_y, w_x, w_y, u_xx, u_yy, u_xy, v_xx, v_yy, v_xy, w_xx, w_yy, w_xy
    cdef double e[6]
    cdef double sg[6]
    cdef double S[15]
    cdef double pA[15]
    cdef double fAu, fAu_x, fAu_xx, fAv, fAv_x, fAv_xx, fAw
    cdef double fAw_x, fAw_xx, gAu, gAu_y, gAu_yy, gAv, gAv_y
    cdef double gAv_yy, gAw, gAw_y, gAw_yy

    cdef double [::1] fint

    # F as 4-D matrix, must be [nx, ny, 6, 6], when there is one ABD[6, 6] for
    # each of the nx * ny integration points
    cdef double F[6 * 6]
    cdef double [:, :, :, ::1] Fnxny

    cdef int one_F_each_point = 0

    Finput = np.ascontiguousarray(Finput, dtype=DOUBLE)
    if Finput.shape == (nx, ny, 6, 6):
        Fnxny = Finput
        one_F_each_point = 1
    elif Finput.shape == (6, 6):
        # creating dummy 4-D array that is not used
        Fnxny = np.empty(shape=(0, 0, 0, 0), dtype=DOUBLE)
        # using a constant F for all the integration domain
        for i in range(6):
            for j in range(6):
                F[i*6 + j] = Finput[i, j]
    else:
        raise ValueError('Invalid shape for Finput!')

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    #NOTE physical limits of the integration domain, resolved and validated
    #      by Shell.integration_limits(); for the full domain the mapping
    #      below gives exactly xi1 = eta1 = -1 and xi2 = eta2 = +1
    x1, x2, y1, y2 = shell.integration_limits()
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)

    xinf = 0
    xsup = shell.a
    xi1 = (x1 - xinf)/(xsup - xinf)*2 - 1
    xi2 = (x2 - xinf)/(xsup - xinf)*2 - 1

    yinf = 0
    ysup = shell.b
    eta1 = (y1 - yinf)/(ysup - yinf)*2 - 1
    eta2 = (y2 - yinf)/(ysup - yinf)*2 - 1

    intx = x2 - x1
    inty = y2 - y1

    ftab = np.zeros((9, m), dtype=DOUBLE)
    gtab = np.zeros((9, n), dtype=DOUBLE)

    fint = np.zeros(size, dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                xi = xis[ptx]
                eta = etas[pty]
                xi = (xi - (-1))/2 * (xi2 - xi1) + xi1
                eta = (eta - (-1))/2 * (eta2 - eta1) + eta1

                # the integrands are per unit area of the natural domain
                weight = weights_xi[ptx]*weights_eta[pty]*intx*inty/4

                if one_F_each_point == 1:
                    for i in range(6):
                        for j in range(6):
                            F[i*6 + j] = Fnxny[ptx, pty, i, j]

                # approximation functions and their derivatives in x and y
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = (2/a)*fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = (2/a)*(2/a)*fpp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[3, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = (2/a)*fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[5, i] = (2/a)*(2/a)*fpp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[6, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[7, i] = (2/a)*fp(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[8, i] = (2/a)*(2/a)*fpp(i, xi, x1w, x1wr, x2w, x2wr)
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = (2/b)*fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = (2/b)*(2/b)*fpp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[3, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = (2/b)*fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[5, j] = (2/b)*(2/b)*fpp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[6, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[7, j] = (2/b)*fp(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[8, j] = (2/b)*(2/b)*fpp(j, eta, y1w, y1wr, y2w, y2wr)

                # generalized derivatives at the point
                u_x = 0.
                u_y = 0.
                v_x = 0.
                v_y = 0.
                w_x = 0.
                w_y = 0.
                u_xx = 0.
                u_yy = 0.
                u_xy = 0.
                v_xx = 0.
                v_yy = 0.
                v_xy = 0.
                w_xx = 0.
                w_yy = 0.
                w_xy = 0.
                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        col = col0 + DOF*(j*m + i)
                        u_x += fAu_x*gAu*cs[col+0]
                        u_y += fAu*gAu_y*cs[col+0]
                        v_x += fAv_x*gAv*cs[col+1]
                        v_y += fAv*gAv_y*cs[col+1]
                        w_x += fAw_x*gAw*cs[col+2]
                        w_y += fAw*gAw_y*cs[col+2]
                        u_xx += fAu_xx*gAu*cs[col+0]
                        u_yy += fAu*gAu_yy*cs[col+0]
                        u_xy += fAu_x*gAu_y*cs[col+0]
                        v_xx += fAv_xx*gAv*cs[col+1]
                        v_yy += fAv*gAv_yy*cs[col+1]
                        v_xy += fAv_x*gAv_y*cs[col+1]
                        w_xx += fAw_xx*gAw*cs[col+2]
                        w_yy += fAw*gAw_yy*cs[col+2]
                        w_xy += fAw_x*gAw_y*cs[col+2]

                # strains, stresses and S = [B]^T sigma
                e[0] = 0.5*(u_x*u_x) + u_x + 0.5*(v_x*v_x) + 0.5*(w_x*w_x)
                e[1] = 0.5*(u_y*u_y) + 0.5*(v_y*v_y) + v_y + 0.5*(w_y*w_y)
                e[2] = u_x*u_y + u_y + v_x*v_y + v_x + w_x*w_y
                e[3] = u_x*v_xx*w_y - u_x*v_y*w_xx - u_x*w_xx - u_xx*v_x*w_y + u_xx*v_y*w_x + u_xx*w_x + u_y*v_x*w_xx - u_y*v_xx*w_x + v_xx*w_y - v_y*w_xx - w_xx
                e[4] = -u_x*v_y*w_yy + u_x*v_yy*w_y - u_x*w_yy + u_y*v_x*w_yy - u_y*v_yy*w_x - u_yy*v_x*w_y + u_yy*v_y*w_x + u_yy*w_x - v_y*w_yy + v_yy*w_y - w_yy
                e[5] = 2*u_x*v_xy*w_y - 2*u_x*v_y*w_xy - 2*u_x*w_xy - 2*u_xy*v_x*w_y + 2*u_xy*v_y*w_x + 2*u_xy*w_x + 2*u_y*v_x*w_xy - 2*u_y*v_xy*w_x + 2*v_xy*w_y - 2*v_y*w_xy - 2*w_xy
                for r in range(6):
                    sg[r] = 0.
                    for s in range(6):
                        sg[r] += F[r*6 + s]*e[s]
                S[0] = sg[0]*u_x + sg[0] + sg[2]*u_y + sg[3]*v_xx*w_y - sg[3]*v_y*w_xx - sg[3]*w_xx - sg[4]*v_y*w_yy + sg[4]*v_yy*w_y - sg[4]*w_yy + 2*sg[5]*v_xy*w_y - 2*sg[5]*v_y*w_xy - 2*sg[5]*w_xy
                S[1] = sg[1]*u_y + sg[2]*u_x + sg[2] + sg[3]*v_x*w_xx - sg[3]*v_xx*w_x + sg[4]*v_x*w_yy - sg[4]*v_yy*w_x + 2*sg[5]*v_x*w_xy - 2*sg[5]*v_xy*w_x
                S[2] = sg[0]*v_x + sg[2]*v_y + sg[2] - sg[3]*u_xx*w_y + sg[3]*u_y*w_xx + sg[4]*u_y*w_yy - sg[4]*u_yy*w_y - 2*sg[5]*u_xy*w_y + 2*sg[5]*u_y*w_xy
                S[3] = sg[1]*v_y + sg[1] + sg[2]*v_x - sg[3]*u_x*w_xx + sg[3]*u_xx*w_x - sg[3]*w_xx - sg[4]*u_x*w_yy + sg[4]*u_yy*w_x - sg[4]*w_yy - 2*sg[5]*u_x*w_xy + 2*sg[5]*u_xy*w_x - 2*sg[5]*w_xy
                S[4] = sg[0]*w_x + sg[2]*w_y + sg[3]*u_xx*v_y + sg[3]*u_xx - sg[3]*u_y*v_xx - sg[4]*u_y*v_yy + sg[4]*u_yy*v_y + sg[4]*u_yy + 2*sg[5]*u_xy*v_y + 2*sg[5]*u_xy - 2*sg[5]*u_y*v_xy
                S[5] = sg[1]*w_y + sg[2]*w_x + sg[3]*u_x*v_xx - sg[3]*u_xx*v_x + sg[3]*v_xx + sg[4]*u_x*v_yy - sg[4]*u_yy*v_x + sg[4]*v_yy + 2*sg[5]*u_x*v_xy - 2*sg[5]*u_xy*v_x + 2*sg[5]*v_xy
                S[6] = -sg[3]*v_x*w_y + sg[3]*v_y*w_x + sg[3]*w_x
                S[7] = -sg[4]*v_x*w_y + sg[4]*v_y*w_x + sg[4]*w_x
                S[8] = -2*sg[5]*v_x*w_y + 2*sg[5]*v_y*w_x + 2*sg[5]*w_x
                S[9] = sg[3]*u_x*w_y - sg[3]*u_y*w_x + sg[3]*w_y
                S[10] = sg[4]*u_x*w_y - sg[4]*u_y*w_x + sg[4]*w_y
                S[11] = 2*sg[5]*u_x*w_y - 2*sg[5]*u_y*w_x + 2*sg[5]*w_y
                S[12] = -sg[3]*u_x*v_y - sg[3]*u_x + sg[3]*u_y*v_x - sg[3]*v_y - sg[3]
                S[13] = -sg[4]*u_x*v_y - sg[4]*u_x + sg[4]*u_y*v_x - sg[4]*v_y - sg[4]
                S[14] = -2*sg[5]*u_x*v_y - 2*sg[5]*u_x + 2*sg[5]*u_y*v_x - 2*sg[5]*v_y - 2*sg[5]

                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        col = col0 + DOF*(j*m + i)
                        pA[0] = fAu_x*gAu
                        pA[1] = fAu*gAu_y
                        pA[2] = fAv_x*gAv
                        pA[3] = fAv*gAv_y
                        pA[4] = fAw_x*gAw
                        pA[5] = fAw*gAw_y
                        pA[6] = fAu_xx*gAu
                        pA[7] = fAu*gAu_yy
                        pA[8] = fAu_x*gAu_y
                        pA[9] = fAv_xx*gAv
                        pA[10] = fAv*gAv_yy
                        pA[11] = fAv_x*gAv_y
                        pA[12] = fAw_xx*gAw
                        pA[13] = fAw*gAw_yy
                        pA[14] = fAw_x*gAw_y
                        fint[col+0] += weight*(pA[0]*S[0] + pA[1]*S[1] + pA[6]*S[6] + pA[7]*S[7] + pA[8]*S[8])
                        fint[col+1] += weight*(pA[2]*S[2] + pA[3]*S[3] + pA[9]*S[9] + pA[10]*S[10] + pA[11]*S[11])
                        fint[col+2] += weight*(pA[4]*S[4] + pA[5]*S[5] + pA[12]*S[12] + pA[13]*S[13] + pA[14]*S[14])

    return fint


def calc_kTv(double [::1] cs, double [::1] vs, object Finput, object shell,
        int size, int col0, int nx, int ny, double Nxx_cte=0.,
        double Nyy_cte=0., double Nxy_cte=0.):
    r"""Product of the tangent stiffness matrix by a vector, without assembly

    Returns `\boldsymbol{K}_T(\boldsymbol{c}) \boldsymbol{v}`, with `\boldsymbol{K}_T` the
    tangent stiffness matrix ``fkC_num(cs, ..., NLgeom=1) + fkG_num(cs, ...)``
    at ``cs``, i.e. the exact Jacobian of :func:`calc_fint`, plus the geometric
    stiffness matrix of the constant membrane stress state ``Nxx_cte``,
    ``Nyy_cte`` and ``Nxy_cte``, multiplied by ``vs``. At each integration
    point, with ``d = [Phi] cs`` and ``dv = [Phi] vs``::

        kTv += [Phi]^T ([B(d)]^T [ABD] [B(d)] dv + [H(sigma + Nbar, d)] dv)

    with ``sigma = [ABD] eps(d)``. The cost is about that of
    :func:`calc_fint`.

    Parameters
    ----------
    cs, vs : array-like
        Ritz constants of the configuration and the vector, of size ``size``.
    Finput : array-like
        Constitutive matrix ``(6, 6)``, or one for each integration point
        ``(nx, ny, 6, 6)``.
    shell : :class:`.Shell`
        The shell.
    size, col0 : int
        Size of the vectors and offset of the shell in them.
    nx, ny : int
        Number of integration points.
    Nxx_cte, Nyy_cte, Nxy_cte : float, optional
        Constant membrane stress state.

    Returns
    -------
    kTv : np.ndarray
        The product, of size ``size``.

    """
    cdef double x1, x2, y1, y2, xinf, xsup, yinf, ysup
    cdef double a, b, intx, inty
    cdef int m, n
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, p, q, r, s, row, col, ptx, pty
    cdef double xi, eta, weight
    cdef double xi1, xi2, eta1, eta2
    cdef double [:, ::1] ftab, gtab
    cdef double [::1] xis, etas, weights_xi, weights_eta

    cdef double u_x, u_y, v_x, v_y, w_x, w_y, u_xx, u_yy
    cdef double u_xy, v_xx, v_yy, v_xy, w_xx, w_yy, w_xy
    cdef double du_x, du_y, dv_x, dv_y, dw_x, dw_y, du_xx, du_yy
    cdef double du_xy, dv_xx, dv_yy, dv_xy, dw_xx, dw_yy, dw_xy
    cdef double e[6]
    cdef double de[6]
    cdef double sg[6]
    cdef double dsg[6]
    cdef double S[15]
    cdef double pA[15]
    cdef double fAu, fAu_x, fAu_xx, fAv, fAv_x, fAv_xx, fAw
    cdef double fAw_x, fAw_xx, gAu, gAu_y, gAu_yy, gAv, gAv_y
    cdef double gAv_yy, gAw, gAw_y, gAw_yy

    cdef double [::1] kTv

    if cs.shape[0] != size or vs.shape[0] != size:
        raise ValueError('cs and vs must have the size %d' % size)

    # F as 4-D matrix, must be [nx, ny, 6, 6], when there is one ABD[6, 6] for
    # each of the nx * ny integration points
    cdef double F[6 * 6]
    cdef double [:, :, :, ::1] Fnxny

    cdef int one_F_each_point = 0

    Finput = np.ascontiguousarray(Finput, dtype=DOUBLE)
    if Finput.shape == (nx, ny, 6, 6):
        Fnxny = Finput
        one_F_each_point = 1
    elif Finput.shape == (6, 6):
        # creating dummy 4-D array that is not used
        Fnxny = np.empty(shape=(0, 0, 0, 0), dtype=DOUBLE)
        # using a constant F for all the integration domain
        for i in range(6):
            for j in range(6):
                F[i*6 + j] = Finput[i, j]
    else:
        raise ValueError('Invalid shape for Finput!')

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    #NOTE physical limits of the integration domain, resolved and validated
    #      by Shell.integration_limits(); for the full domain the mapping
    #      below gives exactly xi1 = eta1 = -1 and xi2 = eta2 = +1
    x1, x2, y1, y2 = shell.integration_limits()
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)

    xinf = 0
    xsup = shell.a
    xi1 = (x1 - xinf)/(xsup - xinf)*2 - 1
    xi2 = (x2 - xinf)/(xsup - xinf)*2 - 1

    yinf = 0
    ysup = shell.b
    eta1 = (y1 - yinf)/(ysup - yinf)*2 - 1
    eta2 = (y2 - yinf)/(ysup - yinf)*2 - 1

    intx = x2 - x1
    inty = y2 - y1

    ftab = np.zeros((9, m), dtype=DOUBLE)
    gtab = np.zeros((9, n), dtype=DOUBLE)

    kTv = np.zeros(size, dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                xi = xis[ptx]
                eta = etas[pty]
                xi = (xi - (-1))/2 * (xi2 - xi1) + xi1
                eta = (eta - (-1))/2 * (eta2 - eta1) + eta1

                # the integrands are per unit area of the natural domain
                weight = weights_xi[ptx]*weights_eta[pty]*intx*inty/4

                if one_F_each_point == 1:
                    for i in range(6):
                        for j in range(6):
                            F[i*6 + j] = Fnxny[ptx, pty, i, j]

                # approximation functions and their derivatives in x and y
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = (2/a)*fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = (2/a)*(2/a)*fpp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[3, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = (2/a)*fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[5, i] = (2/a)*(2/a)*fpp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[6, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[7, i] = (2/a)*fp(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[8, i] = (2/a)*(2/a)*fpp(i, xi, x1w, x1wr, x2w, x2wr)
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = (2/b)*fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = (2/b)*(2/b)*fpp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[3, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = (2/b)*fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[5, j] = (2/b)*(2/b)*fpp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[6, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[7, j] = (2/b)*fp(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[8, j] = (2/b)*(2/b)*fpp(j, eta, y1w, y1wr, y2w, y2wr)

                # generalized derivatives of cs and vs at the point
                u_x = 0.
                u_y = 0.
                v_x = 0.
                v_y = 0.
                w_x = 0.
                w_y = 0.
                u_xx = 0.
                u_yy = 0.
                u_xy = 0.
                v_xx = 0.
                v_yy = 0.
                v_xy = 0.
                w_xx = 0.
                w_yy = 0.
                w_xy = 0.
                du_x = 0.
                du_y = 0.
                dv_x = 0.
                dv_y = 0.
                dw_x = 0.
                dw_y = 0.
                du_xx = 0.
                du_yy = 0.
                du_xy = 0.
                dv_xx = 0.
                dv_yy = 0.
                dv_xy = 0.
                dw_xx = 0.
                dw_yy = 0.
                dw_xy = 0.
                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        col = col0 + DOF*(j*m + i)
                        u_x += fAu_x*gAu*cs[col+0]
                        u_y += fAu*gAu_y*cs[col+0]
                        v_x += fAv_x*gAv*cs[col+1]
                        v_y += fAv*gAv_y*cs[col+1]
                        w_x += fAw_x*gAw*cs[col+2]
                        w_y += fAw*gAw_y*cs[col+2]
                        u_xx += fAu_xx*gAu*cs[col+0]
                        u_yy += fAu*gAu_yy*cs[col+0]
                        u_xy += fAu_x*gAu_y*cs[col+0]
                        v_xx += fAv_xx*gAv*cs[col+1]
                        v_yy += fAv*gAv_yy*cs[col+1]
                        v_xy += fAv_x*gAv_y*cs[col+1]
                        w_xx += fAw_xx*gAw*cs[col+2]
                        w_yy += fAw*gAw_yy*cs[col+2]
                        w_xy += fAw_x*gAw_y*cs[col+2]
                        du_x += fAu_x*gAu*vs[col+0]
                        du_y += fAu*gAu_y*vs[col+0]
                        dv_x += fAv_x*gAv*vs[col+1]
                        dv_y += fAv*gAv_y*vs[col+1]
                        dw_x += fAw_x*gAw*vs[col+2]
                        dw_y += fAw*gAw_y*vs[col+2]
                        du_xx += fAu_xx*gAu*vs[col+0]
                        du_yy += fAu*gAu_yy*vs[col+0]
                        du_xy += fAu_x*gAu_y*vs[col+0]
                        dv_xx += fAv_xx*gAv*vs[col+1]
                        dv_yy += fAv*gAv_yy*vs[col+1]
                        dv_xy += fAv_x*gAv_y*vs[col+1]
                        dw_xx += fAw_xx*gAw*vs[col+2]
                        dw_yy += fAw*gAw_yy*vs[col+2]
                        dw_xy += fAw_x*gAw_y*vs[col+2]

                # strains, strain increments, stresses
                e[0] = 0.5*(u_x*u_x) + u_x + 0.5*(v_x*v_x) + 0.5*(w_x*w_x)
                e[1] = 0.5*(u_y*u_y) + 0.5*(v_y*v_y) + v_y + 0.5*(w_y*w_y)
                e[2] = u_x*u_y + u_y + v_x*v_y + v_x + w_x*w_y
                e[3] = u_x*v_xx*w_y - u_x*v_y*w_xx - u_x*w_xx - u_xx*v_x*w_y + u_xx*v_y*w_x + u_xx*w_x + u_y*v_x*w_xx - u_y*v_xx*w_x + v_xx*w_y - v_y*w_xx - w_xx
                e[4] = -u_x*v_y*w_yy + u_x*v_yy*w_y - u_x*w_yy + u_y*v_x*w_yy - u_y*v_yy*w_x - u_yy*v_x*w_y + u_yy*v_y*w_x + u_yy*w_x - v_y*w_yy + v_yy*w_y - w_yy
                e[5] = 2*u_x*v_xy*w_y - 2*u_x*v_y*w_xy - 2*u_x*w_xy - 2*u_xy*v_x*w_y + 2*u_xy*v_y*w_x + 2*u_xy*w_x + 2*u_y*v_x*w_xy - 2*u_y*v_xy*w_x + 2*v_xy*w_y - 2*v_y*w_xy - 2*w_xy
                de[0] = du_x*u_x + du_x + dv_x*v_x + dw_x*w_x
                de[1] = du_y*u_y + dv_y*v_y + dv_y + dw_y*w_y
                de[2] = du_x*u_y + du_y*u_x + du_y + dv_x*v_y + dv_x + dv_y*v_x + dw_x*w_y + dw_y*w_x
                de[3] = du_x*v_xx*w_y - du_x*v_y*w_xx - du_x*w_xx - du_xx*v_x*w_y + du_xx*v_y*w_x + du_xx*w_x + du_y*v_x*w_xx - du_y*v_xx*w_x - dv_x*u_xx*w_y + dv_x*u_y*w_xx + dv_xx*u_x*w_y - dv_xx*u_y*w_x + dv_xx*w_y - dv_y*u_x*w_xx + dv_y*u_xx*w_x - dv_y*w_xx + dw_x*u_xx*v_y + dw_x*u_xx - dw_x*u_y*v_xx - dw_xx*u_x*v_y - dw_xx*u_x + dw_xx*u_y*v_x - dw_xx*v_y - dw_xx + dw_y*u_x*v_xx - dw_y*u_xx*v_x + dw_y*v_xx
                de[4] = -du_x*v_y*w_yy + du_x*v_yy*w_y - du_x*w_yy + du_y*v_x*w_yy - du_y*v_yy*w_x - du_yy*v_x*w_y + du_yy*v_y*w_x + du_yy*w_x + dv_x*u_y*w_yy - dv_x*u_yy*w_y - dv_y*u_x*w_yy + dv_y*u_yy*w_x - dv_y*w_yy + dv_yy*u_x*w_y - dv_yy*u_y*w_x + dv_yy*w_y - dw_x*u_y*v_yy + dw_x*u_yy*v_y + dw_x*u_yy + dw_y*u_x*v_yy - dw_y*u_yy*v_x + dw_y*v_yy - dw_yy*u_x*v_y - dw_yy*u_x + dw_yy*u_y*v_x - dw_yy*v_y - dw_yy
                de[5] = 2*du_x*v_xy*w_y - 2*du_x*v_y*w_xy - 2*du_x*w_xy - 2*du_xy*v_x*w_y + 2*du_xy*v_y*w_x + 2*du_xy*w_x + 2*du_y*v_x*w_xy - 2*du_y*v_xy*w_x - 2*dv_x*u_xy*w_y + 2*dv_x*u_y*w_xy + 2*dv_xy*u_x*w_y - 2*dv_xy*u_y*w_x + 2*dv_xy*w_y - 2*dv_y*u_x*w_xy + 2*dv_y*u_xy*w_x - 2*dv_y*w_xy + 2*dw_x*u_xy*v_y + 2*dw_x*u_xy - 2*dw_x*u_y*v_xy - 2*dw_xy*u_x*v_y - 2*dw_xy*u_x + 2*dw_xy*u_y*v_x - 2*dw_xy*v_y - 2*dw_xy + 2*dw_y*u_x*v_xy - 2*dw_y*u_xy*v_x + 2*dw_y*v_xy
                for r in range(6):
                    sg[r] = 0.
                    for s in range(6):
                        sg[r] += F[r*6 + s]*e[s]
                for r in range(6):
                    dsg[r] = 0.
                    for s in range(6):
                        dsg[r] += F[r*6 + s]*de[s]
                sg[0] += Nxx_cte
                sg[1] += Nyy_cte
                sg[2] += Nxy_cte

                # S = [B]^T dsigma + [H(sigma, d)] dv
                S[0] = dsg[0]*u_x + dsg[0] + dsg[2]*u_y + dsg[3]*v_xx*w_y - dsg[3]*v_y*w_xx - dsg[3]*w_xx - dsg[4]*v_y*w_yy + dsg[4]*v_yy*w_y - dsg[4]*w_yy + 2*dsg[5]*v_xy*w_y - 2*dsg[5]*v_y*w_xy - 2*dsg[5]*w_xy + du_x*sg[0] + du_y*sg[2] + dv_xx*sg[3]*w_y + 2*dv_xy*sg[5]*w_y - dv_y*sg[3]*w_xx - dv_y*sg[4]*w_yy - 2*dv_y*sg[5]*w_xy + dv_yy*sg[4]*w_y - dw_xx*sg[3]*v_y - dw_xx*sg[3] - 2*dw_xy*sg[5]*v_y - 2*dw_xy*sg[5] + dw_y*sg[3]*v_xx + dw_y*sg[4]*v_yy + 2*dw_y*sg[5]*v_xy - dw_yy*sg[4]*v_y - dw_yy*sg[4]
                S[1] = dsg[1]*u_y + dsg[2]*u_x + dsg[2] + dsg[3]*v_x*w_xx - dsg[3]*v_xx*w_x + dsg[4]*v_x*w_yy - dsg[4]*v_yy*w_x + 2*dsg[5]*v_x*w_xy - 2*dsg[5]*v_xy*w_x + du_x*sg[2] + du_y*sg[1] + dv_x*sg[3]*w_xx + dv_x*sg[4]*w_yy + 2*dv_x*sg[5]*w_xy - dv_xx*sg[3]*w_x - 2*dv_xy*sg[5]*w_x - dv_yy*sg[4]*w_x - dw_x*sg[3]*v_xx - dw_x*sg[4]*v_yy - 2*dw_x*sg[5]*v_xy + dw_xx*sg[3]*v_x + 2*dw_xy*sg[5]*v_x + dw_yy*sg[4]*v_x
                S[2] = dsg[0]*v_x + dsg[2]*v_y + dsg[2] - dsg[3]*u_xx*w_y + dsg[3]*u_y*w_xx + dsg[4]*u_y*w_yy - dsg[4]*u_yy*w_y - 2*dsg[5]*u_xy*w_y + 2*dsg[5]*u_y*w_xy - du_xx*sg[3]*w_y - 2*du_xy*sg[5]*w_y + du_y*sg[3]*w_xx + du_y*sg[4]*w_yy + 2*du_y*sg[5]*w_xy - du_yy*sg[4]*w_y + dv_x*sg[0] + dv_y*sg[2] + dw_xx*sg[3]*u_y + 2*dw_xy*sg[5]*u_y - dw_y*sg[3]*u_xx - dw_y*sg[4]*u_yy - 2*dw_y*sg[5]*u_xy + dw_yy*sg[4]*u_y
                S[3] = dsg[1]*v_y + dsg[1] + dsg[2]*v_x - dsg[3]*u_x*w_xx + dsg[3]*u_xx*w_x - dsg[3]*w_xx - dsg[4]*u_x*w_yy + dsg[4]*u_yy*w_x - dsg[4]*w_yy - 2*dsg[5]*u_x*w_xy + 2*dsg[5]*u_xy*w_x - 2*dsg[5]*w_xy - du_x*sg[3]*w_xx - du_x*sg[4]*w_yy - 2*du_x*sg[5]*w_xy + du_xx*sg[3]*w_x + 2*du_xy*sg[5]*w_x + du_yy*sg[4]*w_x + dv_x*sg[2] + dv_y*sg[1] + dw_x*sg[3]*u_xx + dw_x*sg[4]*u_yy + 2*dw_x*sg[5]*u_xy - dw_xx*sg[3]*u_x - dw_xx*sg[3] - 2*dw_xy*sg[5]*u_x - 2*dw_xy*sg[5] - dw_yy*sg[4]*u_x - dw_yy*sg[4]
                S[4] = dsg[0]*w_x + dsg[2]*w_y + dsg[3]*u_xx*v_y + dsg[3]*u_xx - dsg[3]*u_y*v_xx - dsg[4]*u_y*v_yy + dsg[4]*u_yy*v_y + dsg[4]*u_yy + 2*dsg[5]*u_xy*v_y + 2*dsg[5]*u_xy - 2*dsg[5]*u_y*v_xy + du_xx*sg[3]*v_y + du_xx*sg[3] + 2*du_xy*sg[5]*v_y + 2*du_xy*sg[5] - du_y*sg[3]*v_xx - du_y*sg[4]*v_yy - 2*du_y*sg[5]*v_xy + du_yy*sg[4]*v_y + du_yy*sg[4] - dv_xx*sg[3]*u_y - 2*dv_xy*sg[5]*u_y + dv_y*sg[3]*u_xx + dv_y*sg[4]*u_yy + 2*dv_y*sg[5]*u_xy - dv_yy*sg[4]*u_y + dw_x*sg[0] + dw_y*sg[2]
                S[5] = dsg[1]*w_y + dsg[2]*w_x + dsg[3]*u_x*v_xx - dsg[3]*u_xx*v_x + dsg[3]*v_xx + dsg[4]*u_x*v_yy - dsg[4]*u_yy*v_x + dsg[4]*v_yy + 2*dsg[5]*u_x*v_xy - 2*dsg[5]*u_xy*v_x + 2*dsg[5]*v_xy + du_x*sg[3]*v_xx + du_x*sg[4]*v_yy + 2*du_x*sg[5]*v_xy - du_xx*sg[3]*v_x - 2*du_xy*sg[5]*v_x - du_yy*sg[4]*v_x - dv_x*sg[3]*u_xx - dv_x*sg[4]*u_yy - 2*dv_x*sg[5]*u_xy + dv_xx*sg[3]*u_x + dv_xx*sg[3] + 2*dv_xy*sg[5]*u_x + 2*dv_xy*sg[5] + dv_yy*sg[4]*u_x + dv_yy*sg[4] + dw_x*sg[2] + dw_y*sg[1]
                S[6] = -dsg[3]*v_x*w_y + dsg[3]*v_y*w_x + dsg[3]*w_x - dv_x*sg[3]*w_y + dv_y*sg[3]*w_x + dw_x*sg[3]*v_y + dw_x*sg[3] - dw_y*sg[3]*v_x
                S[7] = -dsg[4]*v_x*w_y + dsg[4]*v_y*w_x + dsg[4]*w_x - dv_x*sg[4]*w_y + dv_y*sg[4]*w_x + dw_x*sg[4]*v_y + dw_x*sg[4] - dw_y*sg[4]*v_x
                S[8] = -2*dsg[5]*v_x*w_y + 2*dsg[5]*v_y*w_x + 2*dsg[5]*w_x - 2*dv_x*sg[5]*w_y + 2*dv_y*sg[5]*w_x + 2*dw_x*sg[5]*v_y + 2*dw_x*sg[5] - 2*dw_y*sg[5]*v_x
                S[9] = dsg[3]*u_x*w_y - dsg[3]*u_y*w_x + dsg[3]*w_y + du_x*sg[3]*w_y - du_y*sg[3]*w_x - dw_x*sg[3]*u_y + dw_y*sg[3]*u_x + dw_y*sg[3]
                S[10] = dsg[4]*u_x*w_y - dsg[4]*u_y*w_x + dsg[4]*w_y + du_x*sg[4]*w_y - du_y*sg[4]*w_x - dw_x*sg[4]*u_y + dw_y*sg[4]*u_x + dw_y*sg[4]
                S[11] = 2*dsg[5]*u_x*w_y - 2*dsg[5]*u_y*w_x + 2*dsg[5]*w_y + 2*du_x*sg[5]*w_y - 2*du_y*sg[5]*w_x - 2*dw_x*sg[5]*u_y + 2*dw_y*sg[5]*u_x + 2*dw_y*sg[5]
                S[12] = -dsg[3]*u_x*v_y - dsg[3]*u_x + dsg[3]*u_y*v_x - dsg[3]*v_y - dsg[3] - du_x*sg[3]*v_y - du_x*sg[3] + du_y*sg[3]*v_x + dv_x*sg[3]*u_y - dv_y*sg[3]*u_x - dv_y*sg[3]
                S[13] = -dsg[4]*u_x*v_y - dsg[4]*u_x + dsg[4]*u_y*v_x - dsg[4]*v_y - dsg[4] - du_x*sg[4]*v_y - du_x*sg[4] + du_y*sg[4]*v_x + dv_x*sg[4]*u_y - dv_y*sg[4]*u_x - dv_y*sg[4]
                S[14] = -2*dsg[5]*u_x*v_y - 2*dsg[5]*u_x + 2*dsg[5]*u_y*v_x - 2*dsg[5]*v_y - 2*dsg[5] - 2*du_x*sg[5]*v_y - 2*du_x*sg[5] + 2*du_y*sg[5]*v_x + 2*dv_x*sg[5]*u_y - 2*dv_y*sg[5]*u_x - 2*dv_y*sg[5]

                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_y = gtab[1, j]
                    gAu_yy = gtab[2, j]
                    gAv = gtab[3, j]
                    gAv_y = gtab[4, j]
                    gAv_yy = gtab[5, j]
                    gAw = gtab[6, j]
                    gAw_y = gtab[7, j]
                    gAw_yy = gtab[8, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_x = ftab[1, i]
                        fAu_xx = ftab[2, i]
                        fAv = ftab[3, i]
                        fAv_x = ftab[4, i]
                        fAv_xx = ftab[5, i]
                        fAw = ftab[6, i]
                        fAw_x = ftab[7, i]
                        fAw_xx = ftab[8, i]
                        col = col0 + DOF*(j*m + i)
                        pA[0] = fAu_x*gAu
                        pA[1] = fAu*gAu_y
                        pA[2] = fAv_x*gAv
                        pA[3] = fAv*gAv_y
                        pA[4] = fAw_x*gAw
                        pA[5] = fAw*gAw_y
                        pA[6] = fAu_xx*gAu
                        pA[7] = fAu*gAu_yy
                        pA[8] = fAu_x*gAu_y
                        pA[9] = fAv_xx*gAv
                        pA[10] = fAv*gAv_yy
                        pA[11] = fAv_x*gAv_y
                        pA[12] = fAw_xx*gAw
                        pA[13] = fAw*gAw_yy
                        pA[14] = fAw_x*gAw_y
                        kTv[col+0] += weight*(pA[0]*S[0] + pA[1]*S[1] + pA[6]*S[6] + pA[7]*S[7] + pA[8]*S[8])
                        kTv[col+1] += weight*(pA[2]*S[2] + pA[3]*S[3] + pA[9]*S[9] + pA[10]*S[10] + pA[11]*S[11])
                        kTv[col+2] += weight*(pA[4]*S[4] + pA[5]*S[5] + pA[12]*S[12] + pA[13]*S[13] + pA[14]*S[14])

    return np.asarray(kTv)


# BEGIN follower pressure, generated by theory/shells/follower_pressure/write_pyx.py


def calc_fext_follower(double [::1] cs, double [:, ::1] pnxny,
        double px1, double px2, double py1, double py2, object shell,
        int size, int col0, int quadratic=0, int reference=1):
    r"""Force vector of a follower pressure in the configuration ``cs``

    Integrates ``F_p = int p (Nu ax + Nv ay + Nw az) dA`` over the patch
    ``px1 <= x <= px2``, ``py1 <= y <= py2``, with ``nx x ny`` Gauss-Legendre
    points, ``(nx, ny) = pnxny.shape``, being ``pnxny[ptx, pty]`` the pressure,
    already multiplied by the load factor, at each point. The area vector
    ``(ax, ay, az)`` of the deformed mid-surface is, see
    ``theory/shells/follower_pressure``::

        ax = qf*v_x*w_y - qf*v_y*w_x - w_x
        ay = -qf*u_x*w_y + qf*u_y*w_x - w_y
        az = qf*u_x*v_y - qf*u_y*v_x + ref + u_x + v_y

    with ``qf = 1`` for ``quadratic=1`` and ``qf = 0`` otherwise, and ``ref =
    1`` for ``reference=1``, which includes the dead part ``F_p(0)``, and
    ``ref = 0`` otherwise.

    """
    cdef double [:, ::1] gtab, ftab
    cdef double a, b, pintx, pinty, qf
    cdef int m, n, nx, ny
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, col, row, ptx, pty
    cdef double xi, eta, weight
    cdef double u_x, u_y, v_x, v_y, vv, ww, w_x, w_y
    cdef double [::1] xis, etas, weights_xi, weights_eta
    cdef double ref, ax, ay, az
    cdef double fAu, fAu_xi, fAv, fAv_xi, fAw, fAw_xi
    cdef double gAu, gAu_eta, gAv, gAv_eta, gAw, gAw_eta
    cdef double [::1] fext

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    nx = pnxny.shape[0]
    ny = pnxny.shape[1]
    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)
    pintx = px2 - px1
    pinty = py2 - py1
    qf = 1. if quadratic else 0.
    ref = 1. if reference else 0.

    fext = np.zeros(size, dtype=DOUBLE)

    gtab = np.zeros((6, n), dtype=DOUBLE)
    ftab = np.zeros((6, m), dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                # Gauss point of the patch, in the natural coordinates of
                # the approximation functions, which span 0 <= x <= a and
                # 0 <= y <= b
                xi = 2*(px1 + (xis[ptx] + 1)/2*pintx)/a - 1
                eta = 2*(py1 + (etas[pty] + 1)/2*pinty)/b - 1
                weight = (weights_xi[ptx]*weights_eta[pty]*pintx*pinty/4
                          *pnxny[ptx, pty])

                # displacement gradients at the Gauss point
                u_x = u_y = v_x = v_y = w_x = w_y = 0.
                # approximation functions evaluated once, see panels/dev/tabulate.py
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[3, j] = fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[5, j] = fp(j, eta, y1w, y1wr, y2w, y2wr)
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[3, i] = fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[5, i] = fp(i, xi, x1w, x1wr, x2w, x2wr)

                for j in range(n):
                    gAu = gtab[0, j]
                    gAu_eta = gtab[1, j]
                    gAv = gtab[2, j]
                    gAv_eta = gtab[3, j]
                    gAw = gtab[4, j]
                    gAw_eta = gtab[5, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAu_xi = ftab[1, i]
                        fAv = ftab[2, i]
                        fAv_xi = ftab[3, i]
                        fAw = ftab[4, i]
                        fAw_xi = ftab[5, i]
                        col = col0 + DOF*(j*m + i)
                        u_x += cs[col+0]*(2/a)*fAu_xi*gAu
                        u_y += cs[col+0]*(2/b)*fAu*gAu_eta
                        v_x += cs[col+1]*(2/a)*fAv_xi*gAv
                        v_y += cs[col+1]*(2/b)*fAv*gAv_eta
                        w_x += cs[col+2]*(2/a)*fAw_xi*gAw
                        w_y += cs[col+2]*(2/b)*fAw*gAw_eta

                ax = qf*v_x*w_y - qf*v_y*w_x - w_x
                ay = -qf*u_x*w_y + qf*u_y*w_x - w_y
                az = qf*u_x*v_y - qf*u_y*v_x + ref + u_x + v_y

                for j in range(n):
                    gAu = gtab[0, j]
                    gAv = gtab[2, j]
                    gAw = gtab[4, j]
                    for i in range(m):
                        fAu = ftab[0, i]
                        fAv = ftab[2, i]
                        fAw = ftab[4, i]
                        col = col0 + DOF*(j*m + i)
                        fext[col+0] += weight*fAu*gAu*ax
                        fext[col+1] += weight*fAv*gAv*ay
                        fext[col+2] += weight*fAw*gAw*az

    return fext


def fkCfollower_num(double [::1] cs, double [:, ::1] pnxny,
        double px1, double px2, double py1, double py2, object shell,
        int size, int row0, int col0, int quadratic=0):
    r"""Load stiffness ``-dF_p/dc`` of a follower pressure

    See :func:`.calc_fext_follower` for the parameters. The matrix is
    unsymmetric in general, so it is assembled in full, not as an upper
    triangle, and must not be symmetrized. With ``quadratic=0`` it does not
    depend on ``cs``.

    """
    cdef double [:, ::1] gtab, ftab
    cdef double a, b, pintx, pinty, qf
    cdef int m, n, nx, ny
    cdef double x1u, x1ur, x2u, x2ur
    cdef double x1v, x1vr, x2v, x2vr
    cdef double x1w, x1wr, x2w, x2wr
    cdef double y1u, y1ur, y2u, y2ur
    cdef double y1v, y1vr, y2v, y2vr
    cdef double y1w, y1wr, y2w, y2wr

    cdef int i, j, k, l, c, col, row, ptx, pty
    cdef double xi, eta, weight
    cdef double u_x, u_y, v_x, v_y, vv, ww, w_x, w_y
    cdef double [::1] xis, etas, weights_xi, weights_eta
    cdef long [::1] kCr, kCc
    cdef double [::1] kCv
    cdef double fAu, fAu_xi, fAv, fAv_xi, fAw, fAw_xi, fBu, fBu_xi, fBv, fBv_xi, fBw, fBw_xi
    cdef double gAu, gAu_eta, gAv, gAv_eta, gAw, gAw_eta, gBu, gBu_eta, gBv, gBv_eta, gBw, gBw_eta

    if not 'Shell' in shell.__class__.__name__:
        raise ValueError('a Shell object must be given as input')
    a = shell.a
    b = shell.b
    m = shell.m
    n = shell.n
    x1u = shell.x1u; x1ur = shell.x1ur; x2u = shell.x2u; x2ur = shell.x2ur
    x1v = shell.x1v; x1vr = shell.x1vr; x2v = shell.x2v; x2vr = shell.x2vr
    x1w = shell.x1w; x1wr = shell.x1wr; x2w = shell.x2w; x2wr = shell.x2wr
    y1u = shell.y1u; y1ur = shell.y1ur; y2u = shell.y2u; y2ur = shell.y2ur
    y1v = shell.y1v; y1vr = shell.y1vr; y2v = shell.y2v; y2vr = shell.y2vr
    y1w = shell.y1w; y1wr = shell.y1wr; y2w = shell.y2w; y2wr = shell.y2wr

    nx = pnxny.shape[0]
    ny = pnxny.shape[1]
    xis, weights_xi = roots_legendre(nx)
    etas, weights_eta = roots_legendre(ny)
    pintx = px2 - px1
    pinty = py2 - py1
    qf = 1. if quadratic else 0.

    fdim = 6*m*m*n*n
    kCr = np.zeros((fdim,), dtype=INT)
    kCc = np.zeros((fdim,), dtype=INT)
    kCv = np.zeros((fdim,), dtype=DOUBLE)

    gtab = np.zeros((6, n), dtype=DOUBLE)
    ftab = np.zeros((6, m), dtype=DOUBLE)

    with nogil:
        for ptx in range(nx):
            for pty in range(ny):
                # Gauss point of the patch, in the natural coordinates of
                # the approximation functions, which span 0 <= x <= a and
                # 0 <= y <= b
                xi = 2*(px1 + (xis[ptx] + 1)/2*pintx)/a - 1
                eta = 2*(py1 + (etas[pty] + 1)/2*pinty)/b - 1
                weight = (weights_xi[ptx]*weights_eta[pty]*pintx*pinty/4
                          *pnxny[ptx, pty])

                # displacement gradients at the Gauss point, only used by the
                # quadratic area vector
                u_x = u_y = v_x = v_y = w_x = w_y = 0.
                # approximation functions evaluated once, see panels/dev/tabulate.py
                for j in range(n):
                    gtab[0, j] = f(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[1, j] = fp(j, eta, y1u, y1ur, y2u, y2ur)
                    gtab[2, j] = f(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[3, j] = fp(j, eta, y1v, y1vr, y2v, y2vr)
                    gtab[4, j] = f(j, eta, y1w, y1wr, y2w, y2wr)
                    gtab[5, j] = fp(j, eta, y1w, y1wr, y2w, y2wr)
                for i in range(m):
                    ftab[0, i] = f(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[1, i] = fp(i, xi, x1u, x1ur, x2u, x2ur)
                    ftab[2, i] = f(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[3, i] = fp(i, xi, x1v, x1vr, x2v, x2vr)
                    ftab[4, i] = f(i, xi, x1w, x1wr, x2w, x2wr)
                    ftab[5, i] = fp(i, xi, x1w, x1wr, x2w, x2wr)

                if quadratic == 1:
                    for j in range(n):
                        gAu = gtab[0, j]
                        gAu_eta = gtab[1, j]
                        gAv = gtab[2, j]
                        gAv_eta = gtab[3, j]
                        gAw = gtab[4, j]
                        gAw_eta = gtab[5, j]
                        for i in range(m):
                            fAu = ftab[0, i]
                            fAu_xi = ftab[1, i]
                            fAv = ftab[2, i]
                            fAv_xi = ftab[3, i]
                            fAw = ftab[4, i]
                            fAw_xi = ftab[5, i]
                            col = col0 + DOF*(j*m + i)
                            u_x += cs[col+0]*(2/a)*fAu_xi*gAu
                            u_y += cs[col+0]*(2/b)*fAu*gAu_eta
                            v_x += cs[col+1]*(2/a)*fAv_xi*gAv
                            v_y += cs[col+1]*(2/b)*fAv*gAv_eta
                            w_x += cs[col+2]*(2/a)*fAw_xi*gAw
                            w_y += cs[col+2]*(2/b)*fAw*gAw_eta

                c = -1
                for i in range(m):
                    fAu = ftab[0, i]
                    fAu_xi = ftab[1, i]
                    fAv = ftab[2, i]
                    fAv_xi = ftab[3, i]
                    fAw = ftab[4, i]
                    fAw_xi = ftab[5, i]
                    for k in range(m):
                        fBu = ftab[0, k]
                        fBu_xi = ftab[1, k]
                        fBv = ftab[2, k]
                        fBv_xi = ftab[3, k]
                        fBw = ftab[4, k]
                        fBw_xi = ftab[5, k]
                        for j in range(n):
                            gAu = gtab[0, j]
                            gAu_eta = gtab[1, j]
                            gAv = gtab[2, j]
                            gAv_eta = gtab[3, j]
                            gAw = gtab[4, j]
                            gAw_eta = gtab[5, j]
                            for l in range(n):
                                gBu = gtab[0, l]
                                gBu_eta = gtab[1, l]
                                gBv = gtab[2, l]
                                gBv_eta = gtab[3, l]
                                gBw = gtab[4, l]
                                gBw_eta = gtab[5, l]
                                row = row0 + DOF*(j*m + i)
                                col = col0 + DOF*(l*m + k)
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+0
                                    kCc[c] = col+1
                                kCv[c] += weight*( 2*fAu*fBv*gAu*gBv_eta*qf*w_x/b - 2*fAu*fBv_xi*gAu*gBv*qf*w_y/a )
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+0
                                    kCc[c] = col+2
                                kCv[c] += weight*( -2*fAu*fBw*gAu*gBw_eta*qf*v_x/b + 2*fAu*fBw_xi*gAu*gBw*qf*v_y/a + 2*fAu*fBw_xi*gAu*gBw/a )
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+1
                                    kCc[c] = col+0
                                kCv[c] += weight*( -2*fAv*fBu*gAv*gBu_eta*qf*w_x/b + 2*fAv*fBu_xi*gAv*gBu*qf*w_y/a )
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+1
                                    kCc[c] = col+2
                                kCv[c] += weight*( 2*fAv*fBw*gAv*gBw_eta*qf*u_x/b + 2*fAv*fBw*gAv*gBw_eta/b - 2*fAv*fBw_xi*gAv*gBw*qf*u_y/a )
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+2
                                    kCc[c] = col+0
                                kCv[c] += weight*( 2*fAw*fBu*gAw*gBu_eta*qf*v_x/b - 2*fAw*fBu_xi*gAw*gBu*qf*v_y/a - 2*fAw*fBu_xi*gAw*gBu/a )
                                c += 1
                                if ptx == 0 and pty == 0:
                                    kCr[c] = row+2
                                    kCc[c] = col+1
                                kCv[c] += weight*( -2*fAw*fBv*gAw*gBv_eta*qf*u_x/b - 2*fAw*fBv*gAw*gBv_eta/b + 2*fAw*fBv_xi*gAw*gBv*qf*u_y/a )

    kC = coo_matrix((kCv, (kCr, kCc)), shape=(size, size))

    return kC
# END follower pressure
